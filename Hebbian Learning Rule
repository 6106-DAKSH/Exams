
import numpy as np

X = np.array([
    [-1, -1],
    [-1,  1],
    [ 1, -1],
    [ 1,  1]
])

T = np.array([-1, 1, 1, 1])

eta = 1

weights = np.zeros(2)
bias = 0.0

print("Initial Weights:", weights)
print("Initial Bias:", bias)

for x, t in zip(X, T):
    net = np.dot(weights, x) + bias

    if net >= 0:
        y = 1
    else:
        y = -1

    weights = weights + eta * x * t
    bias = bias + eta * t

    print("\nInput:", x)
    print("Target:", t)
    print("Output:", y)
    print("Updated Weights:", weights)
    print("Updated Bias:", bias)

print("\nFinal Weights:", weights)
print("Final Bias:", bias)

print("\nTesting:")

for x in X:
    net = np.dot(weights, x) + bias

    if net >= 0:
        y = 1
    else:
        y = -1

    print(x, "->", y)
