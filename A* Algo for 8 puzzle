
def h(state, goal):
    # Manhattan distance
    distance = 0

    for i in range(9):
        if state[i] != 0:
            j = goal.index(state[i])
            distance += abs(i // 3 - j // 3)
            distance += abs(i % 3 - j % 3)

    return distance


def get_neighbors(state):
    neighbors = []

    zero = state.index(0)
    row = zero // 3
    col = zero % 3

    moves = [(-1, 0), (1, 0), (0, -1), (0, 1)]

    for dr, dc in moves:
        r = row + dr
        c = col + dc

        if 0 <= r < 3 and 0 <= c < 3:
            new = state[:]
            new_zero = r * 3 + c

            new[zero], new[new_zero] = new[new_zero], new[zero]
            neighbors.append(new)

    return neighbors


def astar(start, goal):
    open_list = [(h(start, goal), 0, start, [start])]
    best_g = {tuple(start): 0}

    while open_list:
        open_list.sort(key=lambda x: x[0])
        f, g, state, path = open_list.pop(0)

        if state == goal:
            return path

        if g > best_g.get(tuple(state), float('inf')):
            continue

        for neighbor in get_neighbors(state):
            new_g = g + 1
            key = tuple(neighbor)

            if new_g < best_g.get(key, float('inf')):
                best_g[key] = new_g
                new_f = new_g + h(neighbor, goal)

                open_list.append(
                    (new_f, new_g, neighbor, path + [neighbor])
                )

    return None


# Initial state
start = [
    1, 2, 3,
    4, 0, 6,
    7, 5, 8
]

# Goal state
goal = [
    1, 2, 3,
    4, 5, 6,
    7, 8, 0
]

path = astar(start, goal)

# Print solution
if path:
    print("Solution found in", len(path) - 1, "moves:\n")

    for step in path:
        print(step[0:3])
        print(step[3:6])
        print(step[6:9])
        print()
else:
    print("No solution found.")
